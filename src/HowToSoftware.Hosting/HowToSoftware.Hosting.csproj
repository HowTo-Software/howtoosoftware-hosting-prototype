<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Ensure Blazor framework JS (blazor.web.js) is included during Docker restore
         when .razor files aren't yet present in the restore layer -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <!-- The culture matcher, the redirect guard and the gateway's simulated latency are
         implementation details with no place on the public surface, but they carry rules worth
         testing directly rather than through a rendered page. -->
    <InternalsVisibleTo Include="HowToSoftware.Hosting.Tests" />
  </ItemGroup>

</Project>
