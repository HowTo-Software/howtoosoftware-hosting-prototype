@page "/"
@inject IOptions<SiteOptions> Site
@inject IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<StorefrontText> Text

<PageTitle>@Text["Meta.Title"] | @Site.Value.Name</PageTitle>

<HeadContent>
    <meta name="description" content="@Text["Meta.Description"]" />
    <link rel="canonical" href="@Site.Value.BaseUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@Text["Meta.Title"]" />
    <meta property="og:description" content="@Text["Meta.Description"]" />
    <meta property="og:url" content="@Site.Value.BaseUrl" />
    <meta property="og:site_name" content="@Site.Value.Name" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Text["Meta.Title"]" />
    <meta name="twitter:description" content="@Text["Meta.Description"]" />
    <script type="application/ld+json" nonce="@CspNonce">@((MarkupString)ServiceSchema)</script>
</HeadContent>

<HeroExperience />
<PromotionAnnouncements />
<TrialServerBanner />
<GameGateway />
<PlansTeaser />
<HostingBenefits />
<InfrastructureProof />
<FaqSection Index="06" />
<ClosingSection />

@code {
    private string? CspNonce => SecurityHeadersMiddleware.GetNonce(HttpContextAccessor.HttpContext);
    private string ServiceSchema => System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Service",
        ["name"] = Text["Meta.Title"].Value,
        ["serviceType"] = "Game server hosting",
        ["url"] = Site.Value.BaseUrl,
        ["provider"] = new Dictionary<string, object>
        {
            ["@type"] = "Organization",
            ["name"] = Site.Value.Name,
            ["url"] = Site.Value.BaseUrl
        },
        ["description"] = Text["Meta.Description"].Value
    });
}
