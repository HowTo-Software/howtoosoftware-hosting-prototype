@page "/error"

<PageTitle>Something went wrong</PageTitle>

<section class="hts-section">
    <div class="hts-container hts-container--narrow status-page">
        <p class="status-code">500</p>
        <h1>Something went wrong</h1>
        <p class="hts-lede">
            An unexpected error interrupted that request. Try again in a moment; if it keeps
            happening, let us know and we will look into it.
        </p>
        <CtaButton Href="/" TrailingIcon="IconName.ArrowRight">Back to the homepage</CtaButton>
    </div>
</section>

