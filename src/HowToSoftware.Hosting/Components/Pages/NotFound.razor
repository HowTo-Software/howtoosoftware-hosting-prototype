@page "/not-found"

<PageTitle>Page not found</PageTitle>

<section class="hts-section">
    <div class="hts-container hts-container--narrow status-page">
        <p class="status-code">404</p>
        <h1>We could not find that page</h1>
        <p class="hts-lede">
            The link may be out of date, or the page may have moved. Head back to the homepage
            to pick up where you left off.
        </p>
        <CtaButton Href="/" TrailingIcon="IconName.ArrowRight">Back to the homepage</CtaButton>
    </div>
</section>

