@page "/not-found"
@inject IStringLocalizer<CommonText> Text

<PageTitle>@Text["NotFound.Title"]</PageTitle>

<section class="hts-section">
    <div class="hts-container hts-container--narrow status-page">
        <p class="status-code">@Text["NotFound.Code"]</p>
        <h1>@Text["NotFound.Title"]</h1>
        <p class="hts-lede">@Text["NotFound.Body"]</p>
        <CtaButton Href="/" TrailingIcon="IconName.ArrowRight">@Text["Cta.BackToHomepage"]</CtaButton>
    </div>
</section>

