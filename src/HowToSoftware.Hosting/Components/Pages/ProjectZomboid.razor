@*
    The Project Zomboid hosting page: a headline, a short statement of what every server gets,
    then the plan picker, then the build-to-order panel for anyone the ladder does not reach.

    Deliberately short above the plans. A visitor who arrived from the catalogue has already
    chosen the game; what they need now is what the server does and what it costs, in that
    order and without a marketing article in between.

    Every plan figure is read from the catalogue - the same records the provisioner sends to
    Pterodactyl - and the picker links to the review step with the plan and the period only.
    The price is worked out again on the server at every step after this one.
*@

@page "/game-hosting/project-zomboid"
@using System.Globalization
@inject IGameCatalogService Games
@inject IPlanCatalogService Catalog
@inject IOptions<SiteOptions> Site
@inject IStringLocalizer<CheckoutText> Text

<PageTitle>@Text["Zomboid.MetaTitle"] | @Site.Value.Name</PageTitle>

<HeadContent>
    <meta name="description" content="@Text["Zomboid.MetaDescription"]" />
    <link rel="canonical" href="@($"{Site.Value.BaseUrl.TrimEnd('/')}{SiteRoutes.ProjectZomboid}")" />
</HeadContent>

<section class="zomboid-hero" aria-labelledby="zomboid-heading" data-motion="scene" data-scene>
    <div class="hts-container hts-container--wide">
        <div class="hero-copy" data-reveal>
            <nav class="hero-crumbs" data-motion-step="label" aria-label="@Text["Zomboid.CrumbLabel"]">
                <a href="@SiteRoutes.GameHosting">@Text["Zomboid.Crumb"]</a>
                <span class="crumb-sep" aria-hidden="true">/</span>
                <span class="crumb-here">@Game.Name</span>
            </nav>

            <h1 id="zomboid-heading" class="hero-title" data-text-effect="rise" data-motion-step="headline">@Text["Zomboid.Title"]</h1>
            <p class="hero-lede" data-motion-step="copy">@Text["Zomboid.Lede"]</p>

            <div class="hero-actions" data-motion-step="details">
                <CtaButton Href="#plans" Variant="CtaVariant.Primary" TrailingIcon="IconName.ArrowRight">
                    @Text["Zomboid.CtaPlans"]
                </CtaButton>
                <CtaButton Href="#custom-build" Variant="CtaVariant.Secondary">
                    @Text["Zomboid.CtaCustom"]
                </CtaButton>
            </div>

            <dl class="hero-facts" data-motion-step="details" data-scene-exit>
                @if (From is { } from)
                {
                    <div>
                        <dt class="hts-label">@Text["Zomboid.FactFrom"]</dt>
                        <dd class="hts-mono">@Catalog.CurrencySymbol@from.ToString("0.00", Invariant)<span class="fact-unit">@Text["GameHosting.PerMonth"]</span></dd>
                    </div>
                }
                @if (Plans.Count > 0)
                {
                    <div>
                        <dt class="hts-label">@Text["Zomboid.FactPlans"]</dt>
                        <dd class="hts-mono" data-count="@Plans.Count">@Plans.Count</dd>
                    </div>
                    <div>
                        <dt class="hts-label">@Text["Zomboid.FactMemory"]</dt>
                        <dd class="hts-mono">@Plans[0].MemoryGb–@Plans[^1].MemoryGb GB</dd>
                    </div>
                }
            </dl>
        </div>

    </div>
</section>

@* The live rail is deliberately part of the product path, not only the home page. *@
<TelemetryStrip />

<section class="features" aria-labelledby="features-heading" data-motion="section">
    <div class="hts-container hts-container--wide">
        <header class="features-head" data-reveal>
            <p class="features-kicker" data-motion-step="label">
                <span class="kicker-index">01</span>
                <span class="hts-label">@Text["Zomboid.FeatureKicker"]</span>
            </p>
            <h2 id="features-heading" class="features-title" data-motion-step="headline">@Text["Zomboid.FeatureTitle"]</h2>
        </header>

        <ul class="feature-grid" data-motion-stagger>
            @foreach (var (feature, index) in Features.Select((f, i) => (f, i)))
            {
                <li data-reveal data-motion-step="card" style="--hts-reveal-delay: @(index * 50)ms">
                    <span class="feature-index hts-mono">@((index + 1).ToString("00"))</span>
                    <h3 class="feature-name">@feature.Label</h3>
                    <p class="feature-detail">@feature.Detail</p>
                </li>
            }
        </ul>
    </div>
</section>

<PlanPicker Game="Game" Plans="Plans" Index="02" />

<CustomBuildSection />

<FaqSection Index="04" />

<section class="zomboid-back">
    <div class="hts-container hts-container--wide">
        <a class="back-link" href="@SiteRoutes.GameHosting">
            <Icon Name="IconName.ArrowRight" CssClass="is-sm" />
            <span>@Text["Zomboid.BackToCatalog"]</span>
        </a>
    </div>
</section>

@code {
    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;

    private sealed record Feature(string Label, string Detail);

    private HostedGame Game => Games.Primary;

    private IReadOnlyList<HostingPlan> Plans => Games.PlansFor(Game);

    private decimal? From => Games.StartingPrice(Game);

    /// <summary>
    /// What every server gets. Nine lines, each a thing the panel or the platform actually does;
    /// nothing here is a figure, because none of these is measured.
    /// </summary>
    private Feature[] Features =>
    [
        new(Text["Zomboid.Feature.Build42"], Text["Zomboid.Feature.Build42Detail"]),
        new(Text["Zomboid.Feature.Workshop"], Text["Zomboid.Feature.WorkshopDetail"]),
        new(Text["Zomboid.Feature.Manager"], Text["Zomboid.Feature.ManagerDetail"]),
        new(Text["Zomboid.Feature.Backups"], Text["Zomboid.Feature.BackupsDetail"]),
        new(Text["Zomboid.Feature.Console"], Text["Zomboid.Feature.ConsoleDetail"]),
        new(Text["Zomboid.Feature.Files"], Text["Zomboid.Feature.FilesDetail"]),
        new(Text["Zomboid.Feature.Resources"], Text["Zomboid.Feature.ResourcesDetail"]),
        new(Text["Zomboid.Feature.Panel"], Text["Zomboid.Feature.PanelDetail"]),
        new(Text["Zomboid.Feature.Deploy"], Text["Zomboid.Feature.DeployDetail"])
    ];
}

