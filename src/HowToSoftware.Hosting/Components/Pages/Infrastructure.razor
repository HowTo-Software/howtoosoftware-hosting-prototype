@page "/infrastructure"
@page "/hardware"
@inject IStringLocalizer<HardwareText> Text
@inject IOptions<SiteOptions> Site

@* Both entry points share one canonical, server-rendered infrastructure overview. *@

<PageTitle>@Text["Meta.Title", Site.Value.Name]</PageTitle>

<HeadContent>
    <meta name="description" content="@Text["Meta.Description"]" />
    <link rel="canonical" href="@($"{Site.Value.BaseUrl.TrimEnd('/')}/infrastructure")" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@Text["Meta.Title", Site.Value.Name]" />
    <meta property="og:description" content="@Text["Meta.Description"]" />
    <meta property="og:url" content="@($"{Site.Value.BaseUrl.TrimEnd('/')}/infrastructure")" />
    <meta property="og:site_name" content="@Site.Value.Name" />
</HeadContent>

<HardwareHero SiteName="@Site.Value.Name" />
<NodeGallerySection />
<HardwareOperations />
<HardwareClosing />

