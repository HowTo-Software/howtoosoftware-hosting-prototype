@*
    The face of a game in the catalogue.

    Each game has one banner file with a fixed name (see GameBannerLibrary and
    wwwroot/images/games/README.md). When the file is there, the card shows it edge to edge with
    the status strip along the bottom; while it is missing, the card draws a typographic plate -
    the name stamped on graphite - so the catalogue never shows a broken image or a grey box.

    Nothing here is fetched from a studio's press kit: the banner is whatever the company
    supplies and is entitled to use.

    Decorative: the card around it carries the name and the status as text.
*@

@inject IGameBannerLibrary Banners

<div class="cover cover--@Game.Slug @(Banner.IsAvailable ? "has-banner" : null) @CssClass" aria-hidden="true">
    @if (Banner is { IsAvailable: true, WebPath: { } source })
    {
        <img class="cover-banner" src="@source" alt="" loading="lazy" decoding="async" />
    }
    else
    {
        <div class="cover-grid"></div>

        <div class="cover-face">
            <span class="cover-name">@Game.Name</span>
        </div>
    }

    <div class="cover-foot">
        @if (Game.IsAvailable)
        {
            <span class="cover-lamp"></span>
        }
        <span class="cover-tag">@Tag</span>
    </div>
</div>

@code {
    /// <summary>The game the cover stands for.</summary>
    [Parameter, EditorRequired]
    public HostedGame Game { get; set; } = default!;

    /// <summary>The short mono line in the corner: a status, a build, a region.</summary>
    [Parameter]
    public string? Tag { get; set; }

    /// <summary>Optional additional classes on the root.</summary>
    [Parameter]
    public string? CssClass { get; set; }

    private GameBanner Banner => Banners.Resolve(Game.Slug);
}

