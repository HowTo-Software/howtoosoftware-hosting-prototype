@*
    Physical infrastructure.

    An editorial split rather than a card grid: the specification sheet is set as a ledger -
    label, dot leader, value - beside a drawn rack elevation. Ledgers are what specification
    documents actually look like, and they survive a page where every value is still pending
    far better than four boxes each saying TEXT ABOUT HERE.

    Values come from IInfrastructureContentService. Any spec whose value has not been
    confirmed renders the placeholder; when a real figure is supplied the same row shows it.
*@

@inject IStringLocalizer<HardwareText> Text
@inject IInfrastructureContentService Content

<section class="physical hts-section--soft" id="physical" aria-labelledby="physical-heading">
    <div class="hts-container hts-container--wide physical-inner">
        <div class="physical-copy" data-reveal="left">
            <p class="chapter-kicker" data-text-effect="flicker">
                <span class="kicker-index">@Text["Physical.Index"]</span>
                @Text["Physical.Kicker"]
            </p>

            <h2 class="physical-title" id="physical-heading" data-text-effect="rise">@Text["Physical.Title"]</h2>

            <p class="physical-lede">
                @Text["Physical.Lede"]
            </p>

            <div class="sheet">
                <p class="sheet-label">@Text["Physical.SheetLabel"]</p>

                <dl class="ledger">
                    @foreach (var spec in Content.SpecSheet)
                    {
                        <div class="ledger-row">
                            <dt>@SpecLabel(spec.Kind)</dt>
                            <dd><CopySlot Value="@spec.Value" /></dd>
                        </div>
                    }
                </dl>
            </div>
        </div>

        <div class="physical-figure" data-reveal="right">
            <p class="figure-label">@Text["Physical.PhotoLabel"]</p>

            <HardwarePhoto Slot="HardwarePhotoSlot.RackElevation"
                           CssClass="figure-photo is-lead"
                           Alt="@Text["Photo.Alt.RackElevation"]"
                           Caption="@Text["Photo.Caption.Elevation"]" />
        </div>
    </div>
</section>

@code {
    /// <summary>
    /// Which rack unit each node sits in. Fixed positions so the drawing is stable between
    /// renders; they describe the illustration, not a real elevation.
    /// </summary>
    private static readonly int[] OccupiedUnits = [10, 7, 4];

    private HardwareNode? NodeAt(int unit)
    {
        var index = Array.IndexOf(OccupiedUnits, unit);

        return index >= 0 && index < Content.Nodes.Count ? Content.Nodes[index] : null;
    }

    private string SpecLabel(HardwareSpecKind kind) => kind switch
    {
        HardwareSpecKind.Cpu => Text["Spec.Cpu"],
        HardwareSpecKind.Memory => Text["Spec.Memory"],
        HardwareSpecKind.Storage => Text["Spec.Storage"],
        _ => Text["Spec.Network"]
    };
}

