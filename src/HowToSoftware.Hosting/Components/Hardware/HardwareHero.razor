@*
    Infrastructure page hero.

    Deliberately the same construction as the homepage hero - kicker, stacked display lines
    with the brand purple on one of them, a foot rail of technical readouts - so arriving here
    reads as the next room of the same building.

    Every line of descriptive copy is a placeholder until the real wording is supplied; see
    Components/Shared/CopySlot.razor.
*@

@inject IStringLocalizer<HardwareText> Text
@inject IInfrastructureContentService Content

<section class="hw-hero" id="top" data-motion="scene" data-scene>

    <div class="hts-container hts-container--wide hw-hero-inner">
        <div class="hw-hero-type">
            <p class="hw-kicker" data-text-effect="flicker" data-motion-step="label">
                <span class="kicker-rule" data-motion-draw aria-hidden="true"></span>
                @Text["Hero.Eyebrow"]
            </p>

            <h1 class="hw-title" data-text-effect="rise" data-motion-step="headline">
                <span class="title-line">@Text["Hero.Line1"]</span>
                <span class="title-line title-line--accent">@Text["Hero.Line2"]</span>
                <span class="title-line">@Text["Hero.Line3"]</span>
            </h1>

            <p class="hw-lede" data-motion-step="copy">
                @Text["Hero.Lede"]
            </p>
        </div>

        @* The establishing shot. Above the fold, so it is fetched eagerly rather than lazily. *@
        <div class="hw-hero-plate" data-motion-step="visual">
            <HardwarePhoto Slot="HardwarePhotoSlot.RackFront"
                           Alt="@Text["Photo.Alt.Rack"]"
                           Caption="@Text["Photo.Caption.Rack"]"
                           IsAboveTheFold="true" />
        </div>
    </div>

    <div class="hts-container hts-container--wide hw-hero-foot" data-scene-exit>
        <span class="foot-item">
            <span class="foot-label">@Text["Hero.Rail.Platform"]</span>
            <span class="foot-value">@SiteName</span>
        </span>
        <span class="foot-item">
            <span class="foot-label">@Text["Hero.Rail.Nodes"]</span>
            <span class="foot-value">@Content.Nodes.Count.ToString("00")</span>
        </span>
        <span class="foot-item">
            <span class="foot-label">@Text["Hero.Rail.Region"]</span>
            <span class="foot-value">@Text["Node.RegionValue"]</span>
        </span>
    </div>
</section>

@code {
    /// <summary>Platform name shown on the hero foot rail.</summary>
    [Parameter]
    public string SiteName { get; set; } = "HowToSoftware";
}

