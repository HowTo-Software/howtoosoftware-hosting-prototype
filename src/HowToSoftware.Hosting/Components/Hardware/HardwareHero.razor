@inject IStringLocalizer<HardwareText> Text
@inject IInfrastructureContentService Content

<section class="hw-hero" id="top" aria-labelledby="hw-heading" data-motion="scene" data-scene>
    <div class="hts-container hts-container--wide">
        <div class="hw-hero-inner">
            <div class="hw-hero-type" data-reveal>
                <p class="hw-kicker" data-motion-step="label">@Text["Hero.Eyebrow"]</p>
                <h1 class="hw-title" id="hw-heading" data-motion-step="headline">
                    @Text["Hero.Line1"]
                    <span>@Text["Hero.Line2"] @Text["Hero.Line3"]</span>
                </h1>
                <p class="hw-lede" data-motion-step="copy">@Text["Hero.Lede"]</p>

                <dl class="hw-context">
                    <div>
                        <dt>@Text["Hero.Rail.Nodes"]</dt>
                        <dd>@Content.Nodes.Count.ToString("00")</dd>
                    </div>
                    <div>
                        <dt>@Text["Hero.Rail.Region"]</dt>
                        <dd>@Text["Node.RegionValue"]</dd>
                    </div>
                    <div>
                        <dt>@Text["Hero.Rail.Platform"]</dt>
                        <dd>@Text["Node.PlatformValue"]</dd>
                    </div>
                </dl>

                <div class="hw-hero-actions" data-motion-step="details">
                    <CtaButton Href="@SiteRoutes.ProjectZomboidPlans" TrailingIcon="IconName.ArrowRight">
                        @Text["Closing.Cta"]
                    </CtaButton>
                    <a class="hw-text-link" href="#topology">@Text["Overview.DetailsLink"] <span aria-hidden="true">↓</span></a>
                </div>
            </div>

            <div class="hw-hero-image" data-reveal>
                <HardwarePhoto Slot="HardwarePhotoSlot.RackOpen"
                               Alt="@Text["Photo.Alt.RackOpen"]"
                               Caption="@Text["Overview.RackCaption", SiteName]"
                               IsAboveTheFold="true" />
            </div>
        </div>

        <div class="hw-spec-sheet" id="physical" aria-labelledby="hw-spec-heading" data-reveal>
            <p id="hw-spec-heading" class="hw-spec-heading">@Text["Overview.SpecHeading"]</p>
            <dl class="hw-specs">
                @foreach (var spec in Content.SpecSheet)
                {
                    <div class="hw-spec">
                        <dt>@Text[$"Spec.{spec.Kind}"]</dt>
                        <dd><CopySlot Value="@spec.Value" /></dd>
                        @if (spec.Kind is HardwareSpecKind.Cpu && !spec.IsPending)
                        {
                            <dd class="hw-spec-detail">@Text["Node.CpuDetail"]</dd>
                        }
                    </div>
                }
            </dl>
            <p class="hw-spec-note">@Text["Overview.SpecNote"]</p>
        </div>
    </div>
</section>

@code {
    [Parameter]
    public string SiteName { get; set; } = "HowToSoftware";
}

