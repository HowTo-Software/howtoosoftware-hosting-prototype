@inject IStringLocalizer<HardwareText> Text

<section class="hw-closing" id="get-started" aria-labelledby="hw-closing-heading" data-motion="scene" data-scene>
    <div class="hts-container hts-container--wide closing-inner" data-reveal>
        <div class="closing-copy">
            <h2 class="closing-heading" id="hw-closing-heading" data-motion-step="headline">@Text["Overview.ClosingTitle"]</h2>
            <p class="closing-note" data-motion-step="copy">@Text["Overview.ClosingNote"]</p>
        </div>

        <div class="closing-actions" data-motion-step="details">
            <CtaButton Href="@SiteRoutes.ProjectZomboidPlans" TrailingIcon="IconName.ArrowRight">
                @Text["Closing.Cta"]
            </CtaButton>
            <CtaButton Href="/#trial" Variant="CtaVariant.Secondary">@Text["Overview.TrialCta"]</CtaButton>
        </div>
    </div>
</section>

