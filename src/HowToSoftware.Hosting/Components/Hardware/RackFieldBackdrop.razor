@*
    Infrastructure hero background.

    The homepage hero draws a network; this one draws the thing the network runs on - a rack
    elevation. Rack units as evenly spaced hairlines, two mounting rails, and a slow scan
    passing down the face of it.

    Same construction rules as every other backdrop here: gradients and one inline SVG, no
    image requests, all motion in CSS so reduced-motion switches it off. Decorative, hidden
    from assistive technology.
*@

<div class="rack-field" aria-hidden="true">
    <div class="rack-grid"></div>
    <div class="rack-units"></div>

    <svg class="rack-svg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice"
         fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <radialGradient id="rack-bloom" cx="0.5" cy="0.42" r="0.5">
                <stop offset="0%" stop-color="#b069ff" stop-opacity="0.26" />
                <stop offset="55%" stop-color="#8b32e0" stop-opacity="0.10" />
                <stop offset="100%" stop-color="#83a8f3" stop-opacity="0" />
            </radialGradient>
        </defs>

        @* Two mounting rails with their fixing holes: the vertical rhythm the whole page hangs
           its section indices from. *@
        <g class="rails">
            <path class="rail-post" d="M986 -40V940" />
            <path class="rail-post" d="M1364 -40V940" />

            <g class="rail-holes">
                <path d="M986 92h0M986 164h0M986 236h0M986 308h0M986 380h0M986 452h0M986 524h0M986 596h0M986 668h0M986 740h0M986 812h0" />
                <path d="M1364 92h0M1364 164h0M1364 236h0M1364 308h0M1364 380h0M1364 452h0M1364 524h0M1364 596h0M1364 668h0M1364 740h0M1364 812h0" />
            </g>
        </g>

        @* Three mounted units, drawn as plates between the rails. *@
        <g class="units">
            <rect class="unit is-live" x="986" y="236" width="378" height="58" rx="4" />
            <rect class="unit is-live" x="986" y="380" width="378" height="58" rx="4" />
            <rect class="unit" x="986" y="524" width="378" height="58" rx="4" />
        </g>

        <ellipse class="rack-glow" cx="1175" cy="400" rx="420" ry="420" fill="url(#rack-bloom)" />
    </svg>

    <div class="rack-scan"></div>
    <div class="rack-fade"></div>
</div>

