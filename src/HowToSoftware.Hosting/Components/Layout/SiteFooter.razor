@*
    Site footer: branding, navigation, legal placeholders and contact.

    Legal documents do not exist yet, so they are rendered as clearly-marked placeholders
    rather than links that would 404. No address or phone number is invented here.
*@

@inject IMarketingContentService Content
@inject IStringLocalizer<CommonText> Text
@inject IOptions<SiteOptions> Site

<footer class="site-footer">
    @* A continuous, decorative systems ribbon. The group is deliberately duplicated so the
       translation is seamless; it is aria-hidden because it conveys no live service state. *@
    <div class="footer-ticker" aria-hidden="true">
        <div class="footer-ticker-window">
            <div class="footer-ticker-track">
                @foreach (var copy in Enumerable.Range(0, 2))
                {
                    <ul class="footer-ticker-group">
                        @foreach (var (signal, index) in TickerSignals.Select((signal, index) => (signal, index)))
                        {
                            <li class="footer-ticker-item" style="--ticker-index: @index">
                                <span class="footer-ticker-dot"></span>
                                <span>@signal</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="hts-container hts-container--wide footer-inner">
        <div class="footer-brand">
            <BrandMark Name="@Options.Name" Tagline="@Text["Brand.Tagline"]" CssClass="is-lg is-plain" />
            <p class="footer-blurb">@Text["Footer.Blurb", Options.Name]</p>
            <a class="footer-mail" href="mailto:@Options.ContactEmail">
                <Icon Name="IconName.Mail" CssClass="is-sm" />
                <span>@Options.ContactEmail</span>
            </a>
        </div>

        <nav class="footer-column" aria-labelledby="footer-product">
            <h2 class="footer-title" id="footer-product">@Text["Footer.Product"]</h2>
            <ul>
                @foreach (var link in Content.ProductLinks)
                {
                    <li><a href="@link.Href">@link.Label</a></li>
                }
            </ul>
        </nav>

        <nav class="footer-column" aria-labelledby="footer-company">
            <h2 class="footer-title" id="footer-company">@Text["Footer.Company"]</h2>
            <ul>
                @foreach (var link in Content.CompanyLinks)
                {
                    <li><a href="@link.Href">@link.Label</a></li>
                }
            </ul>
        </nav>

        <section class="footer-column" aria-labelledby="footer-legal">
            <h2 class="footer-title" id="footer-legal">@Text["Footer.Legal"]</h2>
            <ul>
                @foreach (var placeholder in Content.LegalPlaceholders)
                {
                    <li class="footer-placeholder">
                        <span>@placeholder</span>
                        <span class="footer-chip">@Text["Footer.Soon"]</span>
                    </li>
                }
            </ul>
        </section>
    </div>

    <div class="hts-container hts-container--wide footer-base">
        <p>@Text["Footer.Rights", Year, Options.Name]</p>
        <p class="footer-note">@Text["Footer.Trademark"]</p>
    </div>
</footer>

@code {
    private SiteOptions Options => Site.Value;

    private static int Year => DateTime.UtcNow.Year;

    private IReadOnlyList<string> TickerSignals =>
    [
        Text["Footer.Ticker.Live"].Value,
        Text["Footer.Ticker.Game"].Value,
        Text["Footer.Ticker.Workshop"].Value,
        Text["Footer.Ticker.Backups"].Value,
        Text["Footer.Ticker.Deploy"].Value,
        Text["Footer.Ticker.Resources"].Value,
        Text["Footer.Ticker.Panel"].Value,
        Text["Footer.Ticker.Support"].Value
    ];
}

