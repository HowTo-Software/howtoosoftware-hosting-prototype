@inherits LayoutComponentBase
@inject IOptions<SiteOptions> Site
@inject IStringLocalizer<CommonText> Text

<a class="hts-skip-link" href="#main">@Text["Nav.SkipToContent"]</a>

<div class="site-shell">
    <SiteHeader SiteName="@Site.Value.Name" />

    @*
        `data-page-enter` is the hook the route-entrance animation hangs from. The CSS runs on
        first paint; wwwroot/js/site.js re-arms it after Blazor's enhanced navigation patches
        the DOM, because a patched element never replays its animation on its own. Without
        scripting the animation simply runs once, on load, and nothing else changes.
    *@
    <main id="main" tabindex="-1" data-page-enter>
        @Body
    </main>

    <SiteFooter />
</div>

<div id="blazor-error-ui" data-nosnippet>
    @Text["Blazor.ErrorMessage"]
    <a href="." class="reload">@Text["Blazor.Reload"]</a>
    <span class="dismiss">&#128473;</span>
</div>

