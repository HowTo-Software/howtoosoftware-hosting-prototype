@*
    Closing section.

    Full-bleed statement type over the same routed field used in the hero, so the page ends
    where it started and the infrastructure motif closes the loop.
*@

@inject IOptions<SiteOptions> Site
@inject IStringLocalizer<HomeText> Text

<section class="closing" id="get-started" aria-labelledby="closing-heading">
    <div class="closing-field" aria-hidden="true">
        <span class="closing-spine"></span>
        <span class="closing-glow"></span>
    </div>

    <div class="hts-container hts-container--wide closing-inner">
        <div class="closing-copy" data-reveal="left">
            <p class="closing-kicker" data-text-effect="flicker">
                <span class="kicker-dot"></span>
                @Text["Closing.Kicker"]
            </p>

            <h2 id="closing-heading" class="closing-title" data-text-effect="rise">
                @Text["Closing.Line1"]<br />
                <span class="closing-accent">@Text["Closing.Accent"]</span>
            </h2>

            <p class="closing-lede">@Text["Closing.Lede"]</p>

            <div class="closing-actions">
                <CtaButton Href="/project-zomboid" Size="CtaSize.Large" TrailingIcon="IconName.ArrowRight">
                    @Text["Closing.Cta1"]
                </CtaButton>
                <CtaButton Href="#control-panel" Variant="CtaVariant.Secondary" Size="CtaSize.Large">
                    @Text["Closing.Cta2"]
                </CtaButton>
            </div>
        </div>

        <aside class="closing-contact" id="contact" aria-labelledby="contact-heading" data-reveal="right">
            <p class="contact-key">@Text["Closing.ContactKey"]</p>
            <h3 id="contact-heading" class="contact-title">@Text["Closing.ContactTitle"]</h3>
            <p class="contact-copy">@Text["Closing.ContactCopy"]</p>
            <a class="contact-link" href="mailto:@Site.Value.ContactEmail">
                <span>@Site.Value.ContactEmail</span>
                <span class="contact-arrow" aria-hidden="true"></span>
            </a>
        </aside>
    </div>
</section>
