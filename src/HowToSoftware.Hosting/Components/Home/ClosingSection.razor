@inject IOptions<SiteOptions> Site
@inject IStringLocalizer<StorefrontText> Text

<section class="closing" id="get-started" aria-labelledby="closing-heading">
    <div class="hts-container hts-container--wide">
        <div class="closing-inner" data-reveal>
            <div class="closing-copy">
                <p class="storefront-kicker"><span aria-hidden="true">↗</span>@Text["Closing.Kicker"]</p>
                <h2 id="closing-heading"><MaskReveal>@Text["Closing.Title"]</MaskReveal></h2>
                <p>@Text["Closing.Copy"]</p>
                <CtaButton Href="@SiteRoutes.GameHosting" Size="CtaSize.Large" TrailingIcon="IconName.ArrowRight">@Text["Closing.Primary"]</CtaButton>
            </div>
            <aside class="closing-contact" id="contact" aria-labelledby="contact-heading">
                <span class="contact-symbol" aria-hidden="true"><Icon Name="IconName.ArrowRight" /></span>
                <h3 id="contact-heading">@Text["Closing.Contact"]</h3>
                <p>@Text["Closing.ContactCopy"]</p>
                <a class="hts-text-link" href="mailto:@Site.Value.ContactEmail">@Site.Value.ContactEmail <Icon Name="IconName.ArrowRight" /></a>
            </aside>
        </div>
    </div>
</section>
