@*
    The mod installer.

    This panel used to depict a synchronisation queue - bars filling, mods arriving. That showed
    the platform working, which is not the thing worth showing. What is worth showing is the
    work it removes: adding a mod to a Project Zomboid server normally means finding it on the
    Workshop, copying two different identifiers out of the page, pasting each into a different
    configuration line, and getting the order right. Miss one and the server starts without the
    mod; get the order wrong and it starts broken.

    So the panel is now the installer itself: a search, a result, and one button. The identifiers
    are still there, small, under each row - not because a customer needs to read them, but
    because the ones who do should be able to see we wrote them correctly.
*@

@inject IMarketingContentService Content
@inject IStringLocalizer<HomeText> Text
@inject IStringLocalizer<CommonText> Common

<section class="workshop" id="workshop" aria-labelledby="workshop-heading">
    <div class="hts-container hts-container--wide workshop-inner">
        <div class="workshop-copy" data-reveal="left">
            <p class="workshop-kicker" data-text-effect="flicker">
                <span class="kicker-index">02</span>
                @Text["Workshop.Kicker"]
            </p>

            <h2 id="workshop-heading" class="workshop-title" data-text-effect="rise">
                @Text["Workshop.Line1"]<br />
                <span class="workshop-accent">@Text["Workshop.Accent"]</span>
            </h2>

            <p class="workshop-body">@Text["Workshop.Body"]</p>

            <ul class="workshop-points">
                <li><span class="point-mark"></span>@Text["Workshop.Point1"]</li>
                <li><span class="point-mark"></span>@Text["Workshop.Point2"]</li>
                <li><span class="point-mark"></span>@Text["Workshop.Point3"]</li>
                <li><span class="point-mark"></span>@Text["Workshop.Point4"]</li>
            </ul>
        </div>

        <div class="workshop-panel" data-reveal="right" data-spotlight>
            <header class="panel-bar">
                <span class="bar-title">@Text["Installer.Title"]</span>
            </header>

            @* The search field. Not interactive here - the installer runs in the panel, and the
               footer says so rather than letting a visitor discover it by clicking. *@
            <div class="installer-search" aria-hidden="true">
                <span class="search-mark"></span>
                <span class="search-text">@Text["Installer.Search"]</span>
            </div>

            <ul class="mod-list">
                @foreach (var (item, index) in Content.WorkshopItems.Select((m, i) => (m, i)))
                {
                    <li class="mod @StateClass(item.State)" style="--i: @index">
                        <div class="mod-identity">
                            <span class="mod-name">@item.Name</span>
                            <span class="mod-ids">
                                <span class="id-value">@item.WorkshopId</span>
                                <span class="mod-size">@item.SizeLabel</span>
                            </span>
                        </div>

                        @*
                            One control per row. A mod already on the server shows its state
                            instead of a button, because a button that would do nothing is worse
                            than no button.
                        *@
                        @if (item.State is ModSyncState.Queued)
                        {
                            <span class="mod-action">@Text["Installer.Install"]</span>
                        }
                        else
                        {
                            <span class="mod-state">@StateLabel(item.State)</span>
                        }
                    </li>
                }
            </ul>

            <footer class="panel-foot">
                <span class="foot-dot"></span>
                <span>@Text["Installer.Applied"]</span>
                <span class="foot-spacer"></span>
                <span class="foot-note">@Text["Installer.Note"]</span>
            </footer>
        </div>
    </div>
</section>

@code {
    private static string StateClass(ModSyncState state) => state switch
    {
        ModSyncState.Synced => "is-installed",
        ModSyncState.Syncing => "is-staged",
        _ => "is-available"
    };

    private string StateLabel(ModSyncState state) => state switch
    {
        ModSyncState.Synced => Text["Installer.Installed"],
        _ => Text["Installer.Staged"],
    };
}

