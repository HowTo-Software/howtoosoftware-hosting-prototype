@*
    The machines, opening on a photograph of the actual rack.

    The abstract node panels are still here and still carry the specifications - but they used
    to carry the section on their own, which meant the strongest claim the company can make,
    that this hardware physically exists and we own it, was being made entirely in vector
    graphics. A drawing of a server proves nothing. The photograph does.

    The plate is the real rack with its door open. The overlay is the node state, set over it
    rather than beside it, so the reading is one thing: these machines, this state.
*@

@inject IMarketingContentService Content
@inject IStringLocalizer<CommonText> Common
@inject IStringLocalizer<HomeText> Text

<section class="nodes" id="nodes" aria-labelledby="nodes-heading" data-motion="section">
    <div class="hts-container hts-container--wide">
        <header class="nodes-head" data-reveal="rise">
            <p class="nodes-kicker" data-text-effect="flicker" data-motion-step="label">
                <span class="kicker-index">05</span>
                @Text["Nodes.Kicker"]
            </p>
            <h2 id="nodes-heading" class="nodes-title" data-text-effect="rise" data-motion-step="headline">
                @Text["Nodes.Line1"] <span class="nodes-accent">@Text["Nodes.Accent"]</span>
            </h2>
            <p class="nodes-lede" data-motion-step="copy">@Text["Nodes.Lede"]</p>
        </header>

        @*
            Wide crop of a portrait photograph, anchored at 40% so the crop takes the mounted
            machines rather than the ceiling or the floor.
        *@
        <div data-motion-step="visual">
        <RackPlate Slot="HardwarePhotoSlot.RackOpen"
                   Ratio="21 / 9"
                   Position="center 40%"
                   CssClass="nodes-plate"
                   Alt="@Text["Nodes.PlateAlt"]">
            <Overlay>
                <div class="plate-readout">
                    <p class="readout-key">@Text["Nodes.PlateKey"]</p>
                    <ul class="readout-nodes">
                        @foreach (var node in Content.Nodes)
                        {
                            <li>
                                <span class="readout-dot" aria-hidden="true"></span>
                                <span class="readout-id">@node.Id</span>
                                <span class="readout-state">@HealthLabel(node.Health)</span>
                            </li>
                        }
                    </ul>
                </div>
            </Overlay>
        </RackPlate>
        </div>

        <div class="bus" aria-hidden="true">
            <span class="bus-line"></span>
            <span class="bus-label">@Text["Nodes.Bus"]</span>
            <span class="bus-line"></span>
        </div>

        <ul class="node-grid" data-motion-stagger>
            @foreach (var (node, index) in Content.Nodes.Select((n, i) => (n, i)))
            {
                <li class="node-panel @HealthClass(node.Health)" data-reveal data-spotlight data-motion-step="card"
                    style="--hts-reveal-delay: @(index * 90)ms">
                    <span class="node-drop" aria-hidden="true"></span>

                    <header class="node-top">
                        <span class="node-id">@node.Id</span>
                        <span class="node-health">
                            <span class="health-dot"></span>
                            @HealthLabel(node.Health)
                        </span>
                    </header>

                    <p class="node-region">@node.Region</p>

                    <dl class="node-specs">
                        @foreach (var spec in node.Specs)
                        {
                            <div>
                                <dt>@spec.Label</dt>
                                <dd>@spec.Value</dd>
                            </div>
                        }
                    </dl>

                    @if (node.LoadPercent is { } load)
                    {
                        @* Only drawn when there is a live figure behind it. A percentage frozen
                           at build time reads as a fact about the platform right now. *@
                        <div class="node-load">
                            <div class="load-head">
                                <span>@Text["Nodes.Allocation"]</span>
                                <span class="load-value" data-count="@load" data-count-suffix="%">@load%</span>
                            </div>
                            <div class="load-track">
                                <span class="load-fill" style="--target: @(load)%"></span>
                            </div>
                            @if (node.Worlds is { } worlds)
                            {
                                <p class="load-note">
                                    @(worlds > 0 ? Text["Nodes.WorldsPlaced", worlds].Value : Text["Nodes.Awaiting"].Value)
                                </p>
                            }
                        </div>
                    }
                </li>
            }
        </ul>

        <div class="nodes-foot">
            <p class="nodes-note">@Text["Nodes.Note"]</p>

            @* The full picture lives on its own page now; this is the way in. *@
            <CtaButton Href="/infrastructure"
                       Variant="CtaVariant.Secondary"
                       TrailingIcon="IconName.ArrowRight">
                @Common["Cta.SeeTheInfrastructure"]
            </CtaButton>
        </div>
    </div>
</section>

@code {
    private static string HealthClass(NodeHealth health) => health switch
    {
        NodeHealth.Healthy => "is-healthy",
        NodeHealth.Provisioning => "is-provisioning",
        _ => "is-reserved"
    };

    private string HealthLabel(NodeHealth health) => health switch
    {
        NodeHealth.Healthy => Common["Status.Healthy"],
        NodeHealth.Provisioning => Common["Status.Provisioning"],
        _ => Common["Status.Reserved"]
    };
}
