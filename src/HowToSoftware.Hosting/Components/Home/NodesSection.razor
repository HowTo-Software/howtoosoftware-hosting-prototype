@*
    Hardware presented as abstract node panels wired into the provisioning bus, rather than
    stock server-rack photography. Load bars are the only decoration.
*@

@inject IMarketingContentService Content
@inject IStringLocalizer<CommonText> Common
@inject IStringLocalizer<HomeText> Text

<section class="nodes" id="nodes" aria-labelledby="nodes-heading">
    <div class="hts-container hts-container--wide">
        <header class="nodes-head" data-reveal="rise">
            <p class="nodes-kicker">
                <span class="kicker-index">05</span>
                @Text["Nodes.Kicker"]
            </p>
            <h2 id="nodes-heading" class="nodes-title">
                @Text["Nodes.Line1"] <span class="nodes-accent">@Text["Nodes.Accent"]</span>
            </h2>
            <p class="nodes-lede">@Text["Nodes.Lede"]</p>
        </header>

        <div class="bus" aria-hidden="true">
            <span class="bus-line"></span>
            <span class="bus-label">@Text["Nodes.Bus"]</span>
            <span class="bus-line"></span>
        </div>

        <ul class="node-grid">
            @foreach (var (node, index) in Content.Nodes.Select((n, i) => (n, i)))
            {
                <li class="node-panel @HealthClass(node.Health)" data-reveal data-spotlight
                    style="--hts-reveal-delay: @(index * 90)ms">
                    <span class="node-drop" aria-hidden="true"></span>

                    <header class="node-top">
                        <span class="node-id">@node.Id</span>
                        <span class="node-health">
                            <span class="health-dot"></span>
                            @HealthLabel(node.Health)
                        </span>
                    </header>

                    <p class="node-region">@node.Region</p>

                    <dl class="node-specs">
                        @foreach (var spec in node.Specs)
                        {
                            <div>
                                <dt>@spec.Label</dt>
                                <dd>@spec.Value</dd>
                            </div>
                        }
                    </dl>

                    <div class="node-load">
                        <div class="load-head">
                            <span>@Text["Nodes.Allocation"]</span>
                            <span class="load-value">@node.LoadPercent%</span>
                        </div>
                        <div class="load-track">
                            <span class="load-fill" style="--target: @(node.LoadPercent)%"></span>
                        </div>
                        <p class="load-note">
                            @(node.Worlds > 0 ? Text["Nodes.WorldsPlaced", node.Worlds].Value : Text["Nodes.Awaiting"].Value)
                        </p>
                    </div>
                </li>
            }
        </ul>

        <div class="nodes-foot">
            <p class="nodes-note">@Text["Nodes.Note"]</p>

            @* The full picture lives on its own page now; this is the way in. *@
            <CtaButton Href="/infrastructure"
                       Variant="CtaVariant.Secondary"
                       TrailingIcon="IconName.ArrowRight">
                @Common["Cta.SeeTheInfrastructure"]
            </CtaButton>
        </div>
    </div>
</section>

@code {
    private static string HealthClass(NodeHealth health) => health switch
    {
        NodeHealth.Healthy => "is-healthy",
        NodeHealth.Provisioning => "is-provisioning",
        _ => "is-reserved"
    };

    private string HealthLabel(NodeHealth health) => health switch
    {
        NodeHealth.Healthy => Common["Status.Healthy"],
        NodeHealth.Provisioning => Common["Status.Provisioning"],
        _ => Common["Status.Reserved"]
    };
}
