@*
    Hero product layer.

    Several small UI fragments wired into one system, instead of a single dashboard card:
    a status bar, a world/node pair joined through a routing hub, the world instance itself,
    and two readouts hanging off the bottom. Connectors are CSS, so the whole thing reflows
    without a layout engine behind it.
*@

@inject IMarketingContentService Content
@inject IStringLocalizer<HomeText> Text
@inject IStringLocalizer<CommonText> Common

<div class="cluster" aria-hidden="true">
    <div class="frag frag--status">
        <span class="frag-key">@Text["Cluster.ServerStatus"]</span>
        <span class="frag-state">
            <span class="frag-dot"></span>
            @Common["Status.Online"]
        </span>
    </div>

    <div class="link link--down"></div>

    <div class="cluster-row">
        <div class="frag frag--side">
            <span class="frag-key">@Text["Cluster.World"]</span>
            <span class="frag-value">knox-county-01</span>
        </div>

        <div class="cluster-hub">
            <span class="hub-line"></span>
            <span class="hub-dot"></span>
            <span class="hub-line"></span>
        </div>

        <div class="frag frag--side">
            <span class="frag-key">@Text["Cluster.Node"]</span>
            <span class="frag-value">EU WEST / 01</span>
        </div>
    </div>

    <div class="link link--down"></div>

    <div class="frag frag--main">
        <div class="main-head">
            <span class="frag-key">PROJECT ZOMBOID</span>
            <span class="main-build">@Text["Cluster.Build"]</span>
        </div>

        <div class="main-bar">
            <span class="main-fill"></span>
        </div>

        <div class="main-foot">
            <span>@Text["Cluster.WorkshopSync"]</span>
            <span class="main-count">82 / 82</span>
        </div>
    </div>

    <div class="link link--split">
        <span class="split-stem"></span>
        <span class="split-bar"></span>
        <span class="split-leg split-leg--left"></span>
        <span class="split-leg split-leg--right"></span>
    </div>

    <div class="cluster-row cluster-row--readouts">
        @foreach (var signal in Content.HeroSignals)
        {
            <div class="frag frag--readout tone-@signal.Tone.ToString().ToLowerInvariant()">
                <span class="frag-key">@signal.Label</span>
                <span class="frag-value">@signal.Value</span>
            </div>
        }
    </div>
</div>
