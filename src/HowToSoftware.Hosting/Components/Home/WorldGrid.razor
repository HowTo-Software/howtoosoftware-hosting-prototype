@*
    Stylised Project Zomboid world grid.

    Cells are placed by coordinate, so the layout is data-driven rather than hand-positioned
    markup. A scan line sweeps across the field and loaded cells breathe very slightly, which
    reads as a live simulation without any of it being real.
*@

@inject IStringLocalizer<HomeText> Text

<figure class="grid-figure">
    <figcaption class="grid-caption">
        <span class="caption-key">@Text["Grid.Caption"]</span>
        <span class="caption-live">
            <span class="caption-dot"></span>
            @Text["Grid.Streaming"]
        </span>
    </figcaption>

    <div class="grid-frame">
        <div class="grid-axis grid-axis--x" aria-hidden="true">
            @for (var x = 0; x < Columns; x++)
            {
                <span>@(BaseX + x)</span>
            }
        </div>

        <div class="grid-body">
            <div class="grid-axis grid-axis--y" aria-hidden="true">
                @for (var y = 0; y < Rows; y++)
                {
                    <span>@(BaseY + y)</span>
                }
            </div>

            <div class="grid-cells" role="img" aria-label="@Description"
                 style="--cols: @Columns; --rows: @Rows">
                @for (var y = 1; y <= Rows; y++)
                {
                    @for (var x = 1; x <= Columns; x++)
                    {
                        var cell = Find(x, y);
                        <div class="cell @KindClass(cell)" style="--delay: @((x + y) * 90)ms">
                            @if (cell?.Label is { } label)
                            {
                                <span class="cell-label">@label</span>
                            }
                            @if (cell?.Kind is WorldCellKind.Player)
                            {
                                <span class="cell-marker"></span>
                            }
                        </div>
                    }
                }
                <span class="grid-scan" aria-hidden="true"></span>
            </div>
        </div>
    </div>
</figure>

@code {
    /// <summary>Cells to place on the field.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<WorldCell> Cells { get; set; } = [];

    /// <summary>Number of columns rendered.</summary>
    [Parameter]
    public int Columns { get; set; } = 7;

    /// <summary>Number of rows rendered.</summary>
    [Parameter]
    public int Rows { get; set; } = 5;

    /// <summary>First column coordinate shown on the x axis.</summary>
    [Parameter]
    public int BaseX { get; set; } = 35;

    /// <summary>First row coordinate shown on the y axis.</summary>
    [Parameter]
    public int BaseY { get; set; } = 25;

    private string Description =>
        $"Stylised {Columns} by {Rows} grid of Knox County cells showing loaded regions, connected survivors and the server world state.";

    private WorldCell? Find(int x, int y) =>
        Cells.FirstOrDefault(cell => cell.X == x && cell.Y == y);

    private static string KindClass(WorldCell? cell) => cell?.Kind switch
    {
        WorldCellKind.Loaded => "is-loaded",
        WorldCellKind.Player => "is-player",
        WorldCellKind.Safehouse => "is-safehouse",
        WorldCellKind.Server => "is-server",
        _ => "is-empty"
    };
}
