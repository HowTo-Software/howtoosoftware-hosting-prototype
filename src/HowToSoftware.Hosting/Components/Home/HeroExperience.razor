@inject IStringLocalizer<StorefrontText> Text

<section class="hero" id="top" data-home-hero aria-labelledby="hero-heading">
    <div class="hts-container hts-container--wide hero-inner">
        <p class="hero-kicker"><span class="kicker-line" aria-hidden="true"></span>@Text["Hero.Kicker"]</p>
        <div class="hero-wordmark-shell" aria-hidden="true"><VectorWordmark Text="HTS" CssClass="hero-wordmark" /></div>
        <h1 id="hero-heading" class="hero-title">
            <MaskReveal>@Text["Hero.Line1"]</MaskReveal>
            <MaskReveal Delay="90"><span class="hero-accent">@Text["Hero.Line2"]</span></MaskReveal>
        </h1>
        <p class="hero-lede" data-reveal>@Text["Hero.Copy"]</p>
        <div class="hero-actions" data-reveal>
            <CtaButton Href="#trial" Size="CtaSize.Large" TrailingIcon="IconName.ArrowRight">@Text["Hero.TrialAction"]</CtaButton>
            <CtaButton Href="@SiteRoutes.ProjectZomboidPlans" Variant="CtaVariant.Secondary" Size="CtaSize.Large">@Text["Hero.Primary"]</CtaButton>
        </div>
        <p class="hero-note">@Text["Hero.Note"]</p>
        <a href="/infrastructure" class="hero-infrastructure hts-text-link">@Text["Hero.Secondary"] <Icon Name="IconName.ArrowRight" /></a>
    </div>
</section>
