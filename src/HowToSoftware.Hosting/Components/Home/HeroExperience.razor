@*
    Immersive hero.

    Three stacked layers - the infrastructure field, the typography, and the connected UI
    cluster - rather than a text/card split. Entry motion is a CSS stagger driven by
    animation-delay, so nothing depends on JavaScript to become visible.
*@

@inject IStringLocalizer<HomeText> Text

<section class="hero" id="top" data-stage>
    <AmbientField Placement="AmbientField.FieldVariant.Right" />

    <div class="hts-container hts-container--wide hero-inner">
        <div class="hero-type">
            <p class="hero-kicker" data-text-effect="flicker">
                <span class="kicker-rule"></span>
                @Text["Hero.Kicker"]
            </p>

            <h1 class="hero-title" data-text-effect="rise">
                <span class="title-line">@Text["Hero.Line1"]</span>
                <span class="title-line title-line--accent">@Text["Hero.Line2"]</span>
                <span class="title-line">@Text["Hero.Line3"]</span>
            </h1>

            <p class="hero-copy">@Text["Hero.Copy"]</p>

            <div class="hero-actions">
                <CtaButton Href="/project-zomboid" Size="CtaSize.Large" TrailingIcon="IconName.ArrowRight">
                    @Text["Hero.CtaPrimary"]
                </CtaButton>
                <CtaButton Href="#control-panel" Variant="CtaVariant.Secondary" Size="CtaSize.Large">
                    @Text["Hero.CtaSecondary"]
                </CtaButton>
            </div>
        </div>

        <div class="hero-product">
            <HeroNodeCluster />
        </div>
    </div>

    <div class="hts-container hts-container--wide hero-foot">
        <span class="foot-coord">@Text["Hero.FootCell"]</span>
        <span class="foot-scroll">
            <span class="foot-scroll-track"><span class="foot-scroll-dot"></span></span>
            @Text["Hero.FootScroll"]
        </span>
        <span class="foot-alloc">@Text["Hero.FootAllocation"]</span>
    </div>
</section>
