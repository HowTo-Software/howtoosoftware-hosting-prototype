@*
    Deployment topology that evolves as the visitor scrolls the provisioning stages.

    Node and link states are computed in C# from the active stage index - the SVG is a pure
    projection of Blazor state, so the diagram and the text can never disagree.

    Boxes are data rather than repeated markup, which also keeps the SVG <text> elements in a
    plain markup context: inside a Razor code block, `<text>` is Razor's own construct and
    cannot carry attributes.
*@

@inject IStringLocalizer<HomeText> Text

<svg class="topology" viewBox="0 0 420 540" fill="none" role="img"
     aria-label="@Description" xmlns="http://www.w3.org/2000/svg">
    <g class="links">
        @foreach (var link in Links)
        {
            @* Two paths, not one. The route is always drawn; the packet is a second stroke on
               top of it. Animating the dash pattern of the route itself made the whole segment
               disappear for most of each cycle - the line would vanish on the stage the reader
               was actually looking at. *@
            <g class="@LinkClass(link.Stage)">
                <path class="link-route" d="@link.Path" />
                <path class="link-packet" d="@link.Path" pathLength="100" />
            </g>
        }
    </g>

    @foreach (var box in Boxes)
    {
        <g class="node @StateFor(box.Stage)">
            <rect x="@box.X" y="@box.Y" width="@box.W" height="@box.H" rx="6" />
            <text class="node-title" x="@(box.X + 14)" y="@(box.Y + 20)">@box.Title</text>
            <text class="node-caption" x="@(box.X + 14)" y="@(box.Y + 34)">@box.Caption</text>
        </g>
    }
</svg>

@code {
    private sealed record TopologyBox(int Stage, int X, int Y, int W, int H, string Title, string Caption);

    private sealed record TopologyLink(int Stage, string Path);

    /// <summary>
    /// The routes between boxes. Each is normalised to <c>pathLength="100"</c> in the markup, so
    /// the travelling packet crosses a short branch and a long one in the same time and with the
    /// same dash geometry - no per-path tuning.
    /// </summary>
    private static readonly TopologyLink[] Links =
    [
        new(0, "M210 62 V108"),
        new(1, "M210 152 V198"),
        new(2, "M210 242 V272 H106 V298"),
        new(2, "M210 242 V272 H314 V298"),
        new(3, "M314 342 V388"),
        new(4, "M314 432 V468")
    ];

    /// <summary>
    /// Geometry is fixed; the words on each box come from the resource set, so the diagram
    /// speaks whatever language the rest of the page does.
    /// </summary>
    private TopologyBox[] Boxes =>
    [
        new(0, 110, 20, 200, 42, Text["Diagram.Customer"], Text["Diagram.CustomerCaption"]),
        new(1, 110, 110, 200, 42, Text["Diagram.Software"], Text["Diagram.SoftwareCaption"]),
        new(2, 110, 200, 200, 42, Text["Diagram.Provisioner"], Text["Diagram.ProvisionerCaption"]),
        new(2, 26, 300, 160, 42, Text["Diagram.Node01"], Text["Diagram.Node01Caption"]),
        new(2, 234, 300, 160, 42, Text["Diagram.Node02"], Text["Diagram.Node02Caption"]),
        new(3, 234, 390, 160, 42, Text["Diagram.Panel"], Text["Diagram.PanelCaption"]),
        new(4, 234, 468, 160, 46, Text["Diagram.World"], Text["Diagram.WorldCaption"])
    ];

    /// <summary>Index of the stage currently in view, zero-based.</summary>
    [Parameter]
    public int ActiveIndex { get; set; }

    private static string Description =>
        "Deployment topology from customer order through the provisioner and a node to the running Project Zomboid world.";

    /// <summary>State of an element that belongs to <paramref name="stageIndex"/>.</summary>
    private string StateFor(int stageIndex) =>
        ActiveIndex > stageIndex ? "is-done"
        : ActiveIndex == stageIndex ? "is-live"
        : "is-idle";

    private string LinkClass(int stageIndex) => $"link {StateFor(stageIndex)}";
}
