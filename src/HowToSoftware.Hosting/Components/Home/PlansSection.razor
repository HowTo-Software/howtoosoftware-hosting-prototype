@*
    Project Zomboid plan catalogue.

    Every resource figure comes from IPlanCatalogService - the same records the provisioner sends
    to Pterodactyl - so what this section advertises and what a customer's server is actually
    created with cannot drift apart. Nothing here restates a memory or CPU number of its own.

    CPU is presented as an allocation percentage, not as a core count, because that is what it
    is: a ceiling on a shared pool. "300% CPU allocation" is true; "3 dedicated cores" would not
    be.

    Prices arrive from configuration and may be absent. When they are, the cards say so and the
    billing switch and coupon field are hidden rather than offering controls that cannot change
    anything.
*@

@rendermode InteractiveServer
@inject IPlanCatalogService Catalog
@inject IStringLocalizer<HomeText> Text

<section class="plans" id="plans" aria-labelledby="plans-heading">
    <div class="hts-container hts-container--wide">
        <header class="plans-head" data-reveal>
            <div class="plans-intro">
                <p class="plans-kicker" data-text-effect="flicker">
                    <span class="kicker-index">06</span>
                    @Text["Plans.Kicker"]
                </p>
                <h2 id="plans-heading" class="plans-title" data-text-effect="rise">
                    @Text["Plans.Line1"]<br />
                    <span class="plans-accent">@Text["Plans.Accent"]</span>
                </h2>
                <p class="plans-lede">@Text["Plans.Lede"]</p>
            </div>

            <aside class="plans-flag" role="note">
                <span class="flag-tag">@(Catalog.HasPricing ? Text["Plans.FlagTag"] : Text["Plans.FlagTagUnpriced"])</span>
                <p>@(Catalog.HasPricing ? Text["Plans.FlagBody"] : Text["Plans.FlagBodyUnpriced"])</p>
            </aside>
        </header>

        @if (Catalog.HasPricing)
        {
            <div class="plans-controls" data-reveal>
                <div class="switch" role="group" aria-label="@Text["Plans.BillingLabel"]">
                    @foreach (var option in Catalog.BillingOptions)
                    {
                        <button type="button"
                                class="switch-item @(option.Period == _period ? "is-active" : null)"
                                aria-pressed="@((option.Period == _period).ToString().ToLowerInvariant())"
                                @onclick="() => _period = option.Period">
                            @option.Label
                            @if (option.DiscountPercent > 0)
                            {
                                <span class="switch-save">-@option.DiscountPercent%</span>
                            }
                        </button>
                    }
                </div>

                <div class="coupon">
                    <label class="coupon-label" for="coupon-code">@Text["Plans.CouponLabel"]</label>
                    <div class="coupon-row">
                        <input id="coupon-code"
                               class="coupon-input @(_coupon.Status == CouponStatus.Rejected ? "is-bad" : null) @(_coupon.IsApplied ? "is-good" : null)"
                               type="text"
                               autocomplete="off"
                               spellcheck="false"
                               placeholder="@Text["Plans.CouponPlaceholder"]"
                               aria-describedby="coupon-result"
                               value="@_code"
                               @oninput="OnCodeInput"
                               @onkeydown="OnCodeKeyDown" />

                        @if (_coupon.IsApplied)
                        {
                            <button type="button" class="coupon-btn coupon-btn--clear" @onclick="Clear">@Text["Plans.CouponRemove"]</button>
                        }
                        else
                        {
                            <button type="button" class="coupon-btn" @onclick="Apply">@Text["Plans.CouponApply"]</button>
                        }
                    </div>

                    <p id="coupon-result"
                       class="coupon-result @(_coupon.Status == CouponStatus.Rejected ? "is-bad" : null) @(_coupon.IsApplied ? "is-good" : null)"
                       aria-live="polite">
                        @(_coupon.Message.Length > 0 ? _coupon.Message : Text["Plans.CouponHint"].Value)
                    </p>
                </div>
            </div>
        }

        <ul class="plan-grid">
            @foreach (var (plan, index) in Catalog.Plans.Select((p, i) => (p, i)))
            {
                var monthly = Catalog.GetMonthlyRate(plan, _period, _coupon);
                var cycle = Catalog.GetCycleTotal(plan, _period, _coupon);
                var option = Catalog.GetOption(_period);
                var discounted = monthly is { } effective && plan.PriceMonthly is { } list && effective < list;

                <li class="plan @(plan.IsRecommended ? "is-featured" : null)" data-reveal data-spotlight
                    style="--hts-reveal-delay: @(index * 80)ms">

                    @if (plan.IsRecommended)
                    {
                        <span class="plan-flag">@Text["Plans.MostChosen"]</span>
                    }

                    <header class="plan-top">
                        <h3 class="plan-name">@plan.Name</h3>
                        @* A tier whose positioning copy has not been written yet shows the
                           site's placeholder rather than an empty line. *@
                        <p class="plan-tagline"><CopySlot Value="@plan.Tagline" /></p>
                    </header>

                    <div class="plan-price">
                        @if (monthly is { } rate)
                        {
                            @if (discounted && plan.PriceMonthly is { } listPrice)
                            {
                                <span class="price-was">@Catalog.CurrencySymbol@listPrice.ToString("0.00", Culture)</span>
                            }
                            <span class="price-now">
                                <span class="price-symbol">@Catalog.CurrencySymbol</span>@rate.ToString("0.00", Culture)
                            </span>
                            <span class="price-unit">@Text["Plans.PriceUnit"]</span>
                        }
                        else
                        {
                            @* No price has been configured for this plan. The card says so rather
                               than showing a number nobody agreed to. *@
                            <span class="price-pending">@Text["Plans.PricePending"]</span>
                        }
                    </div>

                    @if (monthly is { } charged && Catalog.GetRenewalRate(charged) is { } renewal)
                    {
                        @* Stated per card rather than once under the grid: the figure differs on
                           every tier, and a percentage the reader has to apply themselves is not
                           a price. *@
                        <p class="plan-renewal">
                            @Text["Plans.RenewalLine",
                                  $"{Catalog.CurrencySymbol}{renewal.ToString("0.00", Culture)}"]
                        </p>
                    }

                    <p class="plan-cycle">
                        @if (cycle is { } total)
                        {
                            @if (option.Months > 1)
                            {
                                @Text["Plans.CycleMulti", $"{Catalog.CurrencySymbol}{total.ToString("0.00", Culture)}", option.Months]
                            }
                            else
                            {
                                @Text["Plans.CycleMonthly"]
                            }
                        }
                        else
                        {
                            @Text["Plans.PricePendingNote"]
                        }
                    </p>

                    @* The headline resource. RAM is what actually differs between these tiers and
                       what a Zomboid community shops on, so it takes the position the slot count
                       used to hold. *@
                    <div class="plan-headline">
                        <span class="headline-value">@plan.MemoryGb</span>
                        <span class="headline-unit">@Text["Plans.MemoryUnit"]</span>
                        <span class="headline-key">@Text["Plans.MemoryLabel"]</span>
                    </div>

                    <dl class="plan-specs">
                        <div>
                            <dt>@Text["Plans.SpecCpu"]</dt>
                            <dd>@Text["Plans.CpuValue", plan.CpuPercent]</dd>
                        </div>
                        <div>
                            <dt>@Text["Plans.SpecStorage"]</dt>
                            <dd>@Text["Plans.StorageValue", plan.DiskGb]</dd>
                        </div>
                        <div>
                            <dt>@Text["Plans.SpecBackups"]</dt>
                            <dd>@plan.BackupLimit</dd>
                        </div>
                    </dl>

                    @if (plan.HasServerBot)
                    {
                        @* Read from the tier's own memory, never from a flag somebody could
                           tick on the wrong row. *@
                        <p class="plan-bot">
                            <span class="bot-dot" aria-hidden="true"></span>
                            <span class="bot-name">@Text["Plans.BotBadge"]</span>
                            <span class="bot-state">@Text["Plans.BotIncluded"]</span>
                        </p>
                    }

                    <ul class="plan-includes">
                        @foreach (var include in plan.Includes)
                        {
                            <li><span class="include-mark"></span>@include</li>
                        }
                    </ul>

                    <CtaButton Href="#contact"
                               Variant="@(plan.IsRecommended ? CtaVariant.Primary : CtaVariant.Secondary)"
                               CssClass="plan-cta">
                        @Text["Plans.Deploy", plan.Name]
                    </CtaButton>
                </li>
            }
        </ul>

        @* Said once, under the grid, rather than repeated on eight cards. *@
        <p class="plans-note">@Text["Plans.CpuNote"]</p>
        <p class="plans-note">@Text["Plans.BotNote", ServerBot.MinimumMemoryGb]</p>

        @if (Catalog.HasPricing && Catalog.RenewalDiscountPercent > 0m)
        {
            <p class="plans-note">@Text["Plans.RenewalNote"]</p>
        }
    </div>
</section>

@code {
    private static readonly System.Globalization.CultureInfo Culture =
        System.Globalization.CultureInfo.InvariantCulture;

    private BillingPeriod _period = BillingPeriod.Monthly;
    private string _code = string.Empty;
    private CouponResult _coupon = CouponResult.None;

    private void OnCodeInput(ChangeEventArgs args)
    {
        _code = args.Value?.ToString() ?? string.Empty;

        // Editing after a decision clears it, so the panel never shows a stale verdict.
        if (_coupon.Status is not CouponStatus.None)
        {
            _coupon = CouponResult.None;
        }
    }

    private void OnCodeKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter")
        {
            Apply();
        }
    }

    private void Apply() => _coupon = Catalog.CheckCoupon(_code);

    private void Clear()
    {
        _code = string.Empty;
        _coupon = CouponResult.None;
    }
}

