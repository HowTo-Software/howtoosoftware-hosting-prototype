@*
    Editorial world section.

    Asymmetric split: oversized statement type on the left, a stylised Knox County coordinate
    grid on the right. No cards, no icons - the grid itself carries the meaning.
*@

@inject IMarketingContentService Content
@inject IStringLocalizer<HomeText> Text

<section class="world" id="world" aria-labelledby="world-heading">
    <div class="hts-container hts-container--wide world-inner">
        <div class="world-copy" data-reveal="left">
            <p class="world-kicker">
                <span class="kicker-index">01</span>
                @Text["World.Kicker"]
            </p>

            <h2 id="world-heading" class="world-title">
                @Text["World.Line1"]<br />
                @Text["World.Line2"] <span class="world-accent">@Text["World.Accent"]</span><br />
                @Text["World.Line3"]
            </h2>

            <p class="world-body">@Text["World.Body1"]</p>

            <p class="world-body">@Text["World.Body2"]</p>

            <dl class="world-readout">
                <div>
                    <dt>@Text["World.DataLabel"]</dt>
                    <dd>@Text["World.DataValue"]</dd>
                </div>
                <div>
                    <dt>@Text["World.RestoreLabel"]</dt>
                    <dd>@Text["World.RestoreValue"]</dd>
                </div>
                <div>
                    <dt>@Text["World.CellLabel"]</dt>
                    <dd>@Text["World.CellValue"]</dd>
                </div>
            </dl>
        </div>

        <div class="world-figure" data-reveal="right">
            <WorldGrid Cells="Content.WorldCells" Columns="7" Rows="5" />
        </div>
    </div>
</section>
