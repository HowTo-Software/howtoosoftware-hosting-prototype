@*
    The instrument beside the sign-in form.

    It draws the path a credential check would take - client, edge, identity, control plane -
    and reports where the current attempt actually got to. Every state on it comes from the
    form's Blazor state: idle while waiting for input, a light travelling the rail while the
    request is in flight, and a stop at the identity hop when there is no provider to answer.

    Decorative in the sense that no one has to read it, so the drawing is aria-hidden; the
    facts it shows are also written out in the status rail underneath, which is not.
*@

@inject IStringLocalizer<LoginText> Text

<aside class="gateway phase-@Phase.ToString().ToLowerInvariant()" data-spotlight
       aria-labelledby="gateway-title">
    <div class="gateway-glow" aria-hidden="true"></div>

    <header class="gateway-head">
        <h2 class="gateway-title" id="gateway-title">@Text["Gateway.Title"]</h2>
        <span class="gateway-state">
            <span class="state-dot" aria-hidden="true"></span>
            @StateLabel
        </span>
    </header>

    <ol class="rail" aria-hidden="true">
        @foreach (var (hop, index) in Hops.Select((hop, index) => (hop, index)))
        {
            <li class="hop @HopClass(index)">
                <span class="hop-mark"></span>
                <span class="hop-label">@hop.Label</span>
                <span class="hop-readout">@hop.Readout</span>
            </li>
        }
        <li class="rail-beam" aria-hidden="true"></li>
    </ol>

    <ul class="signals">
        <li class="signal is-online">
            <span class="signal-dot" aria-hidden="true"></span>@Text["Gateway.NodeOnline"]
        </li>
        <li class="signal is-online">
            <span class="signal-dot" aria-hidden="true"></span>@Text["Gateway.Ready"]
        </li>
        <li class="signal is-online">
            <span class="signal-dot" aria-hidden="true"></span>@Text["Gateway.PlatformOperational"]
        </li>
    </ul>

    <dl class="gateway-meta">
        <div>
            <dt>@Text["Gateway.SessionLabel"]</dt>
            <dd>@Text["Gateway.SessionValue"]</dd>
        </div>
        <div>
            <dt>@Text["Gateway.Region"]</dt>
            <dd>@Text["Gateway.RegionValue"]</dd>
        </div>
    </dl>
</aside>

@code {
    /// <summary>Which stage of the sign-in interaction to depict.</summary>
    [Parameter]
    public GatewayPhase Phase { get; set; } = GatewayPhase.Idle;

    private sealed record Hop(string Label, string Readout);

    /// <summary>The hop the request stops at: identity, because nothing answers there yet.</summary>
    private const int IdentityHop = 2;

    private IReadOnlyList<Hop> Hops =>
    [
        new(Text["Gateway.Client"], Text["Gateway.Handshake"]),
        new(Text["Gateway.Edge"], Text["Gateway.RegionValue"]),
        new(Text["Gateway.Identity"], IdentityReadout),
        new(Text["Gateway.ControlPlane"], Text["Gateway.SessionValue"])
    ];

    private string IdentityReadout => Phase switch
    {
        GatewayPhase.Verifying => Text["Gateway.Verifying"],
        GatewayPhase.Halted => Text["Gateway.NotConnected"],
        _ => Text["Gateway.Awaiting"]
    };

    private string StateLabel => Phase switch
    {
        GatewayPhase.Verifying => Text["Gateway.Verifying"],
        GatewayPhase.Halted => Text["Gateway.Halted"],
        _ => Text["Gateway.Ready"]
    };

    /// <summary>
    /// Hops before identity are always reached. Identity itself is the one that reacts, and
    /// anything past it stays unreached until a real provider is connected.
    /// </summary>
    private string HopClass(int index)
    {
        if (index < IdentityHop)
        {
            return "is-reached";
        }

        if (index > IdentityHop)
        {
            return "is-unreached";
        }

        return Phase switch
        {
            GatewayPhase.Verifying => "is-active",
            GatewayPhase.Halted => "is-halted",
            _ => "is-waiting"
        };
    }
}

