@*
    Sign-in background layer.

    Same drawing language as the homepage hero's infrastructure field - coordinate grid,
    hairline routes, travelling pulses - composed as a convergence instead of a spread:
    several faint paths arriving from off-screen and meeting at one point.

    That meeting point is placed in the corridor between the form and the gateway panel,
    which is the only part of the canvas neither of them covers. The rings expanding out of it
    slide behind both, which is what gives the page its depth: one light source, two opaque
    planes in front of it.

    Pure CSS motion on `stroke-dashoffset` and `transform`, so the global reduced-motion rule
    switches all of it off. Decorative, hidden from assistive technology.
*@

<div class="auth-field" aria-hidden="true">
    <div class="auth-grid"></div>

    <svg class="auth-svg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice"
         fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <linearGradient id="auth-link-blue" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#83a8f3" stop-opacity="0" />
                <stop offset="55%" stop-color="#83a8f3" stop-opacity="0.8" />
                <stop offset="100%" stop-color="#83a8f3" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="auth-link-purple" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#b069ff" stop-opacity="0" />
                <stop offset="55%" stop-color="#b069ff" stop-opacity="0.75" />
                <stop offset="100%" stop-color="#b069ff" stop-opacity="0" />
            </linearGradient>
            <radialGradient id="auth-bloom" cx="0.5" cy="0.5" r="0.5">
                <stop offset="0%" stop-color="#b069ff" stop-opacity="0.40" />
                <stop offset="100%" stop-color="#b069ff" stop-opacity="0" />
            </radialGradient>
        </defs>

        <circle class="auth-bloom" cx="706" cy="524" r="300" fill="url(#auth-bloom)" />

        <g class="auth-routes">
            @* Three requests arriving from off-screen, meeting at the gateway. *@
            <path class="auth-route" d="M-40 108 C 300 108, 480 524, 706 524" />
            <path class="auth-pulse auth-pulse--a" d="M-40 108 C 300 108, 480 524, 706 524" />

            <path class="auth-route" d="M-40 524 C 240 524, 420 524, 706 524" />
            <path class="auth-pulse auth-pulse--b" d="M-40 524 C 240 524, 420 524, 706 524" />

            <path class="auth-route auth-route--purple" d="M-40 892 C 320 892, 500 524, 706 524" />
            <path class="auth-pulse auth-pulse--c" d="M-40 892 C 320 892, 500 524, 706 524" />

        </g>

        <g class="auth-anchors">
            <circle class="auth-ring" cx="706" cy="524" r="24" />
            <circle class="auth-ring auth-ring--wide" cx="706" cy="524" r="24" />
            <circle class="auth-anchor" cx="706" cy="524" r="6" />
        </g>
    </svg>

    <div class="auth-fade"></div>
</div>

