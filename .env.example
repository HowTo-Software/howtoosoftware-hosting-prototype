# Copy to .env (never committed) or use `dotnet user-secrets` in development.
# Every value here is a PLACEHOLDER. Real keys live only in the environment of the host.
#
# ASP.NET Core reads double-underscore names as configuration sections:
#   Stripe__SecretKey  ->  Stripe:SecretKey

# ── Stripe ────────────────────────────────────────────────────────────────────
# Publishable key: safe for the browser, but the site does not currently need it there.
Stripe__PublishableKey=pk_test_REPLACE_ME
# Secret key: SERVER ONLY. Creates Checkout Sessions and reads them back.
Stripe__SecretKey=sk_test_REPLACE_ME
# Webhook signing secret: SERVER ONLY. Verifies the signature on every webhook delivery.
Stripe__WebhookSecret=whsec_REPLACE_ME
# Optional. When unset the site builds these from the request origin.
# {CHECKOUT_SESSION_ID} is substituted by Stripe.
Stripe__SuccessUrl=https://YOUR_DOMAIN/payment/success?session_id={CHECKOUT_SESSION_ID}
Stripe__CancelUrl=https://YOUR_DOMAIN/payment/cancel?order={ORDER_ID}
# Optional. Pre-created Stripe Price ids per plan and period; without them the site sends
# an inline recurring price computed on the server.
#   Stripe__PriceIds__zomboid-8gb:quarterly=price_REPLACE_ME

# ── Pterodactyl (provisioning) ────────────────────────────────────────────────
# Application API key: SERVER ONLY.
Pterodactyl__ApiKey=ptla_REPLACE_ME
Pterodactyl__BaseUrl=https://panel.YOUR_DOMAIN

# ── Order store ───────────────────────────────────────────────────────────────
# SQLite by default; relative to the content root.
ConnectionStrings__Hosting=Data Source=hosting.db
